{
  "name": "sharer",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently --names server,web --prefix-colors blue,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "npm run dev --workspace @sharer/server",
    "dev:web": "npm run dev --workspace @sharer/web",
    "lint": "oxlint --deny-warnings",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test --workspaces",
    "test:integration": "npm run test:integration --workspace @sharer/server",
    "db:migrate": "npm run db:migrate --workspace @sharer/server"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "oxlint": "^1.85.0",
    "prettier": "^3.9.9"
  }
}
